<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mercedes.partsmanager.controller.UserDashboardController"
            style="-fx-background-color: linear-gradient(to bottom right, #F7FBFF, #EEF5FF);">

    <!-- HEADER -->
    <top>
        <VBox spacing="12"
              style="-fx-background-color: rgba(255,255,255,0.75);
                     -fx-border-color: rgba(15, 53, 87, 0.12);
                     -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="16" right="18" bottom="16" left="18"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Mercedes Parts"
                           style="-fx-text-fill:#0F3557; -fx-font-size:18px; -fx-font-weight:bold;"/>
                    <Label text="Catalogue client • Recherche rapide • Panier intelligent"
                           style="-fx-text-fill: rgba(15,53,87,0.65); -fx-font-size:11px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="helloLabel" text="Bonjour"
                       style="-fx-text-fill:#0F3557; -fx-font-size:14px; -fx-font-weight:bold;"/>

                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: rgba(15,53,87,0.08);
                               -fx-text-fill:#0F3557;
                               -fx-background-radius: 14;
                               -fx-padding: 8 14 8 14;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- SEARCH BAR -->
            <HBox spacing="10"
                  style="-fx-background-color: rgba(255,255,255,0.85);
                         -fx-background-radius: 18;
                         -fx-border-radius: 18;
                         -fx-border-color: rgba(15,53,87,0.10);
                         -fx-border-width: 1;">
                <padding>
                    <Insets top="12" right="14" bottom="12" left="14"/>
                </padding>

                <TextField fx:id="searchField"
                           promptText="🔎 Rechercher un produit..."
                           prefWidth="340"
                           style="-fx-background-color: rgba(15,53,87,0.06);
                                  -fx-text-fill: #0F3557;
                                  -fx-prompt-text-fill: rgba(15,53,87,0.55);
                                  -fx-background-radius: 14;
                                  -fx-border-radius: 14;
                                  -fx-border-color: rgba(15,53,87,0.10);
                                  -fx-padding: 10 12 10 12;"/>

                <ComboBox fx:id="categoryCombo"
                          promptText="Catégorie"
                          prefWidth="220"
                          style="-fx-background-color: rgba(15,53,87,0.06);
                                 -fx-text-fill: #0F3557;
                                 -fx-background-radius: 14;
                                 -fx-border-radius: 14;
                                 -fx-border-color: rgba(15,53,87,0.10);
                                 -fx-padding: 6 10 6 10;"/>

                <Button text="Rechercher" onAction="#handleSearch"
                        style="-fx-background-color: linear-gradient(to right, #1E90FF, #00C2FF);
                               -fx-text-fill:white; -fx-font-weight:bold;
                               -fx-background-radius:14;
                               -fx-padding: 10 14 10 14; -fx-cursor: hand;"/>

                <Button text="Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: rgba(15,53,87,0.08);
                               -fx-text-fill:#0F3557;
                               -fx-font-weight:bold;
                               -fx-background-radius:14;
                               -fx-padding: 10 14 10 14; -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="msgLabel"
                       style="-fx-text-fill:#B00020; -fx-font-weight:bold;"/>

                <!-- ✅ Panier via page séparée -->
                <Button text="🛒 Panier" onAction="#handleOpenCart"
                        style="-fx-background-color: linear-gradient(to right, #1E90FF, #00C2FF);
                               -fx-text-fill:white; -fx-font-weight:bold;
                               -fx-background-radius: 14;
                               -fx-padding: 8 14; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- PRODUCTS LIST -->
    <center>
        <StackPane>
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <BorderPane style="-fx-background-color: rgba(255,255,255,0.65);
                               -fx-background-radius: 18;
                               -fx-border-radius: 18;
                               -fx-border-color: rgba(15,53,87,0.10);
                               -fx-border-width: 1;">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>

                <top>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="🧩 Catalogue"
                               style="-fx-text-fill:#0F3557; -fx-font-size:15px; -fx-font-weight:bold;"/>
                    </HBox>
                </top>

                <center>
                    <ListView fx:id="productsList"
                              style="-fx-background-color: transparent;
                                     -fx-control-inner-background: transparent;"
                              prefWidth="980"
                              prefHeight="620"/>
                </center>
            </BorderPane>
        </StackPane>
    </center>

</BorderPane>
