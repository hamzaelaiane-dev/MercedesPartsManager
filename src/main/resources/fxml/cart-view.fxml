<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mercedes.partsmanager.controller.CartController"
            style="-fx-background-color: #0F172A;">

    <!-- HEADER SOMBRE -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1E293B;
                     -fx-border-color: #334155;
                     -fx-border-width: 0 0 1px 0;">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>

            <VBox spacing="4">
                <Label text="🛒 PANIER MERCEDES"
                       style="-fx-text-fill: #60A5FA;
                              -fx-font-size: 22px;
                              -fx-font-weight: 800;"/>
                <Label text="Votre sélection de pièces d'exception"
                       style="-fx-text-fill: #94A3B8;
                              -fx-font-size: 12px;
                              -fx-font-weight: 500;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Retour au catalogue" onAction="#handleBack"
                    style="-fx-background-color: #334155;
                           -fx-text-fill: #CBD5E1;
                           -fx-font-weight: 600;
                           -fx-background-radius: 8px;
                           -fx-border-radius: 8px;
                           -fx-padding: 10px 20px;
                           -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Liste des articles -->
            <ListView fx:id="cartList"
                      prefHeight="500"
                      style="-fx-background-color: #ffffff;
                             -fx-background-radius: 12px;
                             -fx-border-radius: 12px;
                             -fx-border-color: #2b0227;
                             -fx-border-width: 1px;"/>

            <!-- SECTION TOTAUX -->
            <VBox spacing="16"
                  style="-fx-background-color: #1E293B;
                         -fx-background-radius: 12px;
                         -fx-border-radius: 12px;
                         -fx-border-color: #334155;
                         -fx-border-width: 1px;
                         -fx-padding: 24px;">

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox spacing="8">
                        <Button text="🗑️ Supprimer la sélection" onAction="#handleRemove"
                                style="-fx-background-color: #7F1D1D;
                                       -fx-text-fill: #FECACA;
                                       -fx-font-weight: 600;
                                       -fx-background-radius: 8px;
                                       -fx-padding: 10px 16px;
                                       -fx-cursor: hand;"/>

                        <Button text="🧹 Vider le panier" onAction="#handleClear"
                                style="-fx-background-color: #334155;
                                       -fx-text-fill: #CBD5E1;
                                       -fx-font-weight: 600;
                                       -fx-background-radius: 8px;
                                       -fx-padding: 10px 16px;
                                       -fx-cursor: hand;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_RIGHT" spacing="8">
                        <HBox spacing="12" alignment="CENTER_RIGHT">
                            <Label text="Total :"
                                   style="-fx-text-fill: #94A3B8;
                                          -fx-font-size: 16px;
                                          -fx-font-weight: 600;"/>
                            <Label fx:id="totalLabel" text="0,00 DH"
                                   style="-fx-text-fill: #10B981;
                                          -fx-font-size: 28px;
                                          -fx-font-weight: 800;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator style="-fx-border-color: #334155;"/>

                <!-- BOUTON VALIDATION -->
                <Button text="🚀 VALIDER LA COMMANDE" onAction="#handleCheckout"
                        style="-fx-background-color: linear-gradient(to right, #0EA5E9, #3B82F6);
                               -fx-text-fill: white;
                               -fx-font-weight: 700;
                               -fx-font-size: 16px;
                               -fx-background-radius: 8px;
                               -fx-padding: 16px;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(14, 165, 233, 0.4), 10, 0, 0, 5);"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>